{"nodes": [{"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_business_branding_flyer", "label": "Free Business Branding Promo Flyer", "file_type": "image", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "description": "Square social-media promotional flyer on a deep purple gradient with halftone dot texture. Huge white bold geometric sans headline FREE BUSINESS BRANDING, bulleted deliverables list on the left, QR code plus short form link in a magenta panel on the right, a magenta Scan or Use link to register bar, and a white footer strip with offer dates and eligibility terms.", "rationale": "Seed gallery sample on the AD Smart Business Cards landing page: shows the kind of promotional graphic design work AD Graphics produces, as portfolio proof for prospective card customers."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_ad_graphics_brand", "label": "AD Graphics (brand, logo lockup)", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "top-left logo and wordmark", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_branding_offer", "label": "Free Business Branding Offer", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "headline", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Giving away a branding package free acts as a lead-generation and goodwill campaign for AD Graphics, aimed at student entrepreneurs."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_branding_package_deliverables", "label": "Branding Package Deliverables (logo, 3 flyers, T-shirt, packaging, 5 promo designs)", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "bulleted list, left middle", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_ghamsu_ucc_finalist_audience", "label": "Target Audience: GHAMSU UCC Local 2024/25 Finalists", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "footer strip", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eligibility restricted to one campus group (University of Cape Coast, Ghana) to target a niche community and keep the giveaway bounded."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_scarcity_limited_window", "label": "Scarcity Cues: 28-31 Aug 2025 window and Only 3 Slots", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "footer strip", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A four-day offer window and a three-slot cap create urgency and exclusivity to drive immediate registration."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_qr_register_cta", "label": "QR Code and Link Registration Call to Action", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "right-middle panel and register bar", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dual path (scan QR or type the short Google Forms link) lets viewers register straight from a social post or printed copy; this QR-to-action pattern parallels AD Smart NFC and QR digital cards."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_purple_gradient_visual_style", "label": "Purple Gradient Visual Style with Bold Geometric Typography", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "whole composition", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep purple and magenta palette with white heavy sans type gives strong contrast and a modern tech-brand feel, with a clear top-to-bottom hierarchy: logo, headline, benefits, CTA, terms."}, {"id": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_pen_tool_icon_motif", "label": "Vector Pen Tool Icon Motif", "file_type": "concept", "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": "top-right", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A fountain-pen nib with Bezier curve handles signals graphic design and vector craft, reinforcing that the giveaway is a design service."}], "edges": [{"source": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_business_branding_flyer", "target": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_ad_graphics_brand", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": null, "weight": 1.0}, {"source": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_business_branding_flyer", "target": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_branding_offer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "marketing/seed_gallery/15e63b9adcb846e0b337752fc09cf17d.jpg", "source_location": null, "weight": 1.0}, {"source": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_free_branding_offer", "target": "marketing_seed_gallery_15e63b9adcb846e0b337752fc09cf17d_branding_package_deliverables", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "marketing/seed_gallery/15e63b9