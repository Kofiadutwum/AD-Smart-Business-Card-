{"nodes": [{"id": "marketing_seed_gallery_105ef85f15514e91a4da45a2391ffd5d_milestone_poster", "label": "AD Graphics 2.5k+ Designs Milestone Poster", "file_type": "image", "source_file": "marketing/seed_gallery/105ef85f15514e91a4da45a2391ffd5d.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Square social-media style celebration poster by AD Graphics. Used as a seed gallery sample on the AD Smart Business Cards landing page to show the studio's design quality and social proof (volume of work delivered), supporting trust in the business-card offering."}, {"id": "marketing_seed_gallery_105ef85f15514e91a4da45a2391ffd5d_ad_graphics_brand", "label": "AD Graphics Brand (logo and wordmark)", "file_type": "concept", "source_file": "marketing/seed_gallery/105ef85f15514e91a4da45a2391ffd5d.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marketing_seed_gallery_105ef85f15514e91a4da45a2391ffd5d_designs_milestone_claim", "label": "Milestone Claim: 2.5k+ Designs Delivered", "file_type": "concept", "source_file": "marketing/seed_gallery/105ef85f15514e91a4da45a2391ffd5d.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Large embossed gold numeral '2.5k+' with a script 'designs' subtitle is the focal point, acting as social proof of experience and volume."}, {"id": "marketing_seed_gallery_105ef85f15514e91a4da45a2391ffd5d_gold_on_purple_celebration_style", "label": "Gold-on-Purple Celebration Visual Style", "file_type": "concept", "source_file": "marketing/seed_gallery/105ef85f15514e91a4da45a2391ffd5d.jpg", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deep purple textured background with dot-grid pattern, 3D metallic gold lettering, blurred gold confetti ribbons and a torn white paper edge create a prem