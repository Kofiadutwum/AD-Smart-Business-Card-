# Copy to .env for local development. On Render, set these as environment
# variables on the service instead. Never commit a real .env.

DEBUG=1
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(50))"

# The public address. Card URLs, QR codes and NFC tags are built from it, so in
# production it must be the SAME address the Flask site used.
SITE_URL=http://127.0.0.1:8000
# ALLOWED_HOSTS=adsmart.example.com
# CSRF_TRUSTED_ORIGINS=https://adsmart.example.com

# Local default is SQLite. Render sets DATABASE_URL for you.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Payments. Sandbox simulates Paystack end to end and is forced on while the
# secret key is empty.
PAYMENT_SANDBOX=1
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Email. Resend needs a domain you own. Until then, the Gmail API sends from
# the business Gmail (GMAIL_REFRESH_TOKEN from `python manage.py connect_gmail`,
# plus the Google client below); DEFAULT_FROM_EMAIL is then that Gmail address.
# With neither, emails are printed to the console.
RESEND_API_KEY=
GMAIL_REFRESH_TOKEN=
DEFAULT_FROM_EMAIL=AD Smart Business Cards <no-reply@your-domain>
SUPPORT_EMAIL=adgraphics881@gmail.com

# Lets POST /internal/daily-jobs run the daily job (free plan, no cron).
CRON_SECRET=

# Uploaded pictures in production (Cloudinary). Without it, files go to ./media.
CLOUDINARY_URL=

# Google sign-in (same client as the Flask site; callback /auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
